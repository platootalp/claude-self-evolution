{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PROJECT_DIR}/dist/runtime.mjs\" session-start",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PROJECT_DIR}/dist/runtime.mjs\" post-tool-use",
        "timeout": 5,
        "matcher": "*"
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PROJECT_DIR}/dist/runtime.mjs\" stop-gate",
        "timeout": 30
      }
    ]
  }
}